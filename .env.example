# Copy to .env and fill in. Never commit .env.

# LLM + embeddings (any provider supported by LiteLLM)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CHAT_MODEL=anthropic/claude-sonnet-5-5
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Postgres + pgvector (matches docker-compose.yml)
DATABASE_URL=postgresql://ufa:ufa@localhost:5432/ufa

# Companies House (used from week 4)
COMPANIES_HOUSE_API_KEY=

# Retrieval / chunking
CHUNK_TOKENS=512
CHUNK_OVERLAP=64
TOP_K=6
